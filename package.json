{
	"name": "indent-outline",
	"publisher": "otofumi-sunasato",
	"displayName": "%extension.displayName%",
	"description": "%extension.description%",
	"icon": "images/icon.png",
	"version": "0.1.2",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/otofumi-sunasato/indent-outline.git"
	},
	"engines": {
		"vscode": "^1.85.0"
	},
	"categories": [
		"Other"
	],
	"activationEvents": [
		"onLanguage:plaintext"
	],
	"main": "./out/extension.js",
	"contributes": {
		"configuration": {
			"title": "%configuration.title%",
			"properties": {
				"indentOutline.displayMode": {
					"type": "string",
					"enum": [
						"allLines",
						"headingFocused"
					],
					"default": "allLines",
					"description": "%configuration.displayMode.description%",
					"enumDescriptions": [
						"%configuration.displayMode.allLines.description%",
						"%configuration.displayMode.headingFocused.description%"
					]
				},
				"indentOutline.symbolKind": {
					"type": "string",
					"enum": [
						"String",
						"Constant",
						"Method",
						"Number",
						"Array",
						"TypeParameter"
					],
					"default": "String",
					"description": "%configuration.symbolKind.description%",
					"enumDescriptions": [
						"%configuration.symbolKind.string.description%",
						"%configuration.symbolKind.constant.description%",
						"%configuration.symbolKind.method.description%",
						"%configuration.symbolKind.number.description%",
						"%configuration.symbolKind.array.description%",
						"%configuration.symbolKind.typeParameter.description%"
					]
				}
			}
		}
	},
	"scripts": {
		"compile": "tsc -p ./",
		"watch": "tsc -watch -p ./",
		"package": "vsce package"
	},
	"devDependencies": {
		"@types/node": "^20.0.0",
		"@types/vscode": "^1.85.0",
		"@vscode/vsce": "^4.1.0",
		"typescript": "^5.0.0"
	}
}
